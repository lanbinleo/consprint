APP_ENV=production
GIN_MODE=release
# Force the production JWT_SECRET check even when APP_ENV/GIN_MODE are unset.
APP_REQUIRE_SECURE_CONFIG=true
HOST=0.0.0.0
PORT=8080
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
REGISTRATION_INVITE_CODE=change-me-class-code
APP_TIMEZONE=Asia/Shanghai
APP_USE_SYSTEM_TIMEZONE=false
# AP exam day shown in the dashboard countdown (defaults to 2027-05-14).
AP_EXAM_DATE=2027-05-14T12:00:00+08:00
CORS_ORIGIN=https://your-domain.example

# Only needed when running tools/ai-enrich.mjs on the server.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AI_BATCH_SIZE=10
AI_TIMEOUT_MS=60000
AI_RETRIES=1

# Microsoft Entra ID (school Teams account) single sign-on.
# Fill these in once the Entra app registration exists; while empty the
# Microsoft sign-in button is hidden and local email login keeps working.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://your-domain.example/api/auth/entra/callback
ENTRA_ALLOWED_DOMAINS=tsinglan.org
# Override only for tests/mocks; defaults follow the tenant-specific endpoints.
ENTRA_AUTH_BASE_URL=
ENTRA_GRAPH_URL=
# Frontend route that receives the session token via #token=...
ENTRA_FRONTEND_REDIRECT=/auth/callback

# Comma-separated admin emails, promoted at startup and on first sign-in.
ADMIN_EMAILS=leo.huo_27@tsinglan.org

# Display name of the single school tenant.
SCHOOL_NAME=AP Psychology

# Telemetry: activity_events older than this many days are pruned at startup
# (heartbeat rows only; login/page/feature events are kept forever). 0 disables.
TELEMETRY_RETENTION_DAYS=180
